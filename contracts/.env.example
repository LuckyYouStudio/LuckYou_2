# ===== 部署与交互所需环境变量（FR-D-04）=====
# 复制为 .env 后填入真实值；.env 已被 .gitignore 排除，绝不提交

# 部署账户私钥（0x 开头）
PRIVATE_KEY=

# RPC 端点
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Basescan 合约验证 API Key
BASESCAN_API_KEY=

# Chainlink VRF v2.5 订阅 ID（在 vrf.chain.link 创建后填入）
VRF_SUBSCRIPTION_ID=

# 运营抽成接收地址（treasury，测试网可先用部署者地址）
TREASURY_ADDRESS=

# 环境变量（FR-D-04：敏感值绝不入库）
.env
.env.local

# keystore 密码文件（多期验证驱动器用，见 docs/VALIDATION.md）。
# 通配而不是只写一个具体名字：漏一个就是把密码推上去，代价不对称
*.pass
.keeper-pass
keystores/

# Foundry
contracts/out/
contracts/cache/
# 注意：broadcast/ 由 contracts/.gitignore 精细管理（forge 惯例：保留真实网络的
# run-latest.json 作部署存档，忽略本地链、dry-run 与时间戳快照）。此处不再重复声明，
# 否则会与 forge 生成的 `!/broadcast` 否定规则冲突，造成「声明忽略但实际入库」

# Node / Next.js
node_modules/
web/.next/
web/out/
web/tsconfig.tsbuildinfo

# keeper 运行日志
keeper/*.log

# 系统
.DS_Store
Thumbs.db
